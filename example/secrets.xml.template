<?xml version="1.0" encoding="utf-8"?>
<!--
    secrets.xml.template — committed to source control.

    This file documents every key required to build and run the example app.
    Copy this file to secrets.xml (same directory) and fill in real values.
    secrets.xml is gitignored and must NEVER be committed.

    For CI/CD: the generateSecrets Gradle task writes secrets.xml automatically
    from the environment variables listed below. See example/build.gradle.
-->
<resources>

    <!-- Gigya / SAP CDC site API key.
         Env var: GIGYA_API_KEY -->
    <string name="gigya_api_key">YOUR_API_KEY_HERE</string>

    <!-- Gigya / SAP CDC data center (e.g. us1.gigya.com, eu1.gigya.com).
         Env var: GIGYA_API_DOMAIN -->
    <string name="gigya_api_domain">YOUR_API_DOMAIN_HERE</string>

    <!-- Facebook App ID — required for Facebook social login.
         Obtain from https://developers.facebook.com/apps/
         Env var: FACEBOOK_APP_ID -->
    <string name="facebook_app_id">YOUR_FACEBOOK_APP_ID_HERE</string>

    <!-- Facebook Client Token — required for Facebook SDK initialisation.
         Found under App Settings > Advanced > Client Token.
         Env var: FACEBOOK_CLIENT_TOKEN -->
    <string name="facebook_client_token">YOUR_FACEBOOK_CLIENT_TOKEN_HERE</string>

    <!-- Facebook login protocol scheme — must be "fb" + your Facebook App ID.
         e.g. fb113512789545198
         Env var: FACEBOOK_APP_ID (derive: "fb" + value) -->
    <string name="fb_login_protocol_scheme">fbYOUR_FACEBOOK_APP_ID_HERE</string>

    <!-- Google Client ID — required for Google Sign-In / Credential Manager.
         Obtain from Google Cloud Console > APIs & Services > Credentials.
         Env var: GOOGLE_CLIENT_ID -->
    <string name="google_client_id">YOUR_GOOGLE_CLIENT_ID_HERE</string>

</resources>
